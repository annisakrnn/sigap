# Proteksi Direktori Upload SIGAP
# Mencegah eksekusi skrip PHP, CGI, dan skrip eksekusi lainnya
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|inc|pl|py|cgi|sh|bash|exe|asp|aspx|jsp)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
